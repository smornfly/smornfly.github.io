---
import { getCollection } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";
import { site } from "../data/site";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf()
);
const latestPosts = posts.slice(0, 3);
const featuredProjects = projects.filter(({ data }) => data.featured).slice(0, 3);
const visibleProjects = (featuredProjects.length ? featuredProjects : projects).slice(0, 3);
---

<BaseLayout page="home">
  <section class="container hero">
    <div class="hero-copy">
      <span class="mono-label">{site.tagline}</span>
      <h1>在十三区，记录正在生长的<br><em>作品与想法。</em></h1>
      <p class="hero-intro">
        这里是 <strong>{site.name} / {site.subtitle}</strong>。一个持续更新的个人空间，
        用来收纳技术实践、系统思考与那些值得认真完成的事情。
      </p>
      <div class="hero-actions">
        <a class="button button-primary" href="/writing/">
          进入博客
          <svg viewBox="0 0 24 24" aria-hidden="true">
            <path d="M5 12h14M14 7l5 5-5 5"></path>
          </svg>
        </a>
        <a class="button button-secondary" href="/works/">查看作品</a>
      </div>
      <div class="hero-meta">
        <span>真实实践</span>
        <span>持续记录</span>
        <span>慢慢生长</span>
      </div>
    </div>

    <div class="hero-art" aria-hidden="true">
      <div class="orbit">
        <span class="orbit-tag orbit-tag-a">Observe</span>
        <span class="orbit-tag orbit-tag-b">Explain</span>
        <span class="orbit-tag orbit-tag-c">Build</span>
        <div class="orbit-ring"></div>
        <div class="orbit-ring-inner"></div>
        <div class="orbit-core"><span>13</span></div>
      </div>
      <div class="hero-art-note">
        A personal archive in progress.<br>
        No noise, only what matters.
      </div>
    </div>
  </section>

  <section class="section section-line reveal">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="mono-label">Start here</span>
          <h2>空着不是缺点，<br>是给真实内容留的位置。</h2>
        </div>
        <p>
          第一篇文章和第一件作品都在路上。这里不会用虚构经历填满页面，
          每一条新增内容都会来自真实的学习与实践。
        </p>
      </div>

      <div class="growth-grid">
        <a class="growth-card" href="/writing/">
          <div class="growth-top">
            <span class="mono-label">Writing / 01</span>
            <span class="status-pill">{posts.length.toString().padStart(2, "0")} 篇</span>
          </div>
          <div class="growth-body">
            <h3>{posts.length ? "最近写下的内容" : "第一篇文章正在准备中"}</h3>
            <p>
              运维笔记、项目复盘、技术实验和学习记录，会在这里按照时间自然累积。
            </p>
          </div>
          <span class="text-link">
            进入博客
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M14 7l5 5-5 5"></path>
            </svg>
          </span>
        </a>

        <a class="growth-card growth-card-accent" href="/works/">
          <div class="growth-top">
            <span class="mono-label">Works / 02</span>
            <span class="status-pill">{projects.length.toString().padStart(2, "0")} 件</span>
          </div>
          <div class="growth-body">
            <h3>{projects.length ? "最近完成的作品" : "第一件作品正在整理"}</h3>
            <p>
              作品可以是一个系统、一份方案、一个工具，也可以是一次值得记录的实验。
            </p>
          </div>
          <span class="text-link">
            查看作品
            <svg viewBox="0 0 24 24" aria-hidden="true">
              <path d="M5 12h14M14 7l5 5-5 5"></path>
            </svg>
          </span>
        </a>
      </div>
    </div>
  </section>

  {
    latestPosts.length > 0 && (
      <section class="section section-line reveal">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="mono-label">Latest writing</span>
              <h2>最近写下的。</h2>
            </div>
            <a class="text-link" href="/writing/">
              全部文章
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
            </a>
          </div>
          <div class="writing-preview">
            {latestPosts.map((post) => (
              <a class="writing-row" href={`/writing/${post.id}/`}>
                <time class="writing-date" datetime={post.data.date.toISOString()}>
                  {post.data.date.toISOString().slice(0, 10).replaceAll("-", " / ")}
                </time>
                <span class="writing-title">{post.data.title}</span>
                <span class="writing-category">{post.data.tags[0] || "Notes"}</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  {
    visibleProjects.length > 0 && (
      <section class="section section-line reveal">
        <div class="container">
          <div class="section-heading">
            <div>
              <span class="mono-label">Selected work</span>
              <h2>最近完成的作品。</h2>
            </div>
            <a class="text-link" href="/works/">
              全部作品
              <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14M14 7l5 5-5 5"></path></svg>
            </a>
          </div>
          <div class="growth-grid">
            {visibleProjects.map((project, index) => (
              <a class="growth-card" href={`/works/${project.id}/`}>
                <div class="growth-top">
                  <span class="mono-label">Project / {String(index + 1).padStart(2, "0")}</span>
                  <span class="status-pill">{project.data.status}</span>
                </div>
                <div class="growth-body">
                  <h3>{project.data.title}</h3>
                  <p>{project.data.description}</p>
                </div>
                <span class="text-link">查看项目 →</span>
              </a>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <section class="section section-line reveal">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="mono-label">What matters</span>
          <h2>这个空间会坚持<br>三个简单原则。</h2>
        </div>
        <p>内容可以少，但必须诚实、清楚，并且经得起时间。</p>
      </div>
      <div class="principles-grid">
        <article class="principle">
          <span class="principle-index">01 / REAL</span>
          <h3>来自真实实践</h3>
          <p>不搬运没有验证过的经验，也不为了填满页面制造虚构成果。</p>
        </article>
        <article class="principle">
          <span class="principle-index">02 / CLEAR</span>
          <h3>把问题讲清楚</h3>
          <p>保留背景、约束和取舍，让后来的人能够理解当时的判断。</p>
        </article>
        <article class="principle">
          <span class="principle-index">03 / GROW</span>
          <h3>允许持续生长</h3>
          <p>内容会更新，观点会修正，网站也会随着新的实践一起变化。</p>
        </article>
      </div>
    </div>
  </section>

  <section class="section-tight container reveal">
    <div class="closing-cta">
      <span class="mono-label">Open source</span>
      <h2>十三区刚刚开门，内容会慢慢到来。</h2>
      <a class="button" href={site.github} target="_blank" rel="noreferrer">
        在 GitHub 关注
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M5 12h14M14 7l5 5-5 5"></path>
        </svg>
      </a>
    </div>
  </section>
</BaseLayout>
