---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const projects = (await getCollection("projects", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order || b.data.date.valueOf() - a.data.date.valueOf()
);
---

<BaseLayout
  title="作品"
  description="Smornfly 的项目、工具与技术实验。"
  page="works"
>
  <section class="container page-hero">
    <div>
      <span class="mono-label">Selected projects</span>
      <h1>作品会从真实问题<br>开始生长。</h1>
    </div>
    <p>
      这里将记录完整的项目、轻量工具和技术实验。
      比起罗列技术栈，更关注问题、判断与最终产生的影响。
    </p>
  </section>

  <section class="section">
    <div class="container">
      {
        projects.length > 0 ? (
          <div class="works-list">
            {projects.map((project, index) => (
              <article class="work-project reveal">
                <div class="work-visual">
                  <div class="project-art">
                    <div class="visual-system">
                      <div class="grid-lines"></div>
                      <svg viewBox="0 0 600 360" aria-hidden="true">
                        <path
                          d="M70 280C150 278 140 120 245 150s100 106 190 42 74-100 116-91"
                          fill="none"
                          stroke="#d85f39"
                          stroke-width="3"
                        />
                        <g fill="none" stroke="rgba(244,240,232,.2)">
                          <path d="M70 45v270M190 45v270M310 45v270M430 45v270M550 45v270" />
                          <path d="M50 75h520M50 150h520M50 225h520M50 300h520" />
                        </g>
                        <g fill="#f4f0e8">
                          <circle cx="70" cy="280" r="6"></circle>
                          <circle cx="245" cy="150" r="6"></circle>
                          <circle cx="435" cy="192" r="6"></circle>
                          <circle cx="551" cy="101" r="6"></circle>
                        </g>
                        <text
                          x="430"
                          y="335"
                          fill="#f4f0e8"
                          fill-opacity=".5"
                          font-family="monospace"
                          font-size="16"
                        >
                          PROJECT {String(index + 1).padStart(2, "0")}
                        </text>
                      </svg>
                    </div>
                  </div>
                </div>
                <div class="work-content">
                  <span class="mono-label">{project.data.status} / {project.data.date.getFullYear()}</span>
                  <h2>{project.data.title}</h2>
                  <p>{project.data.description}</p>
                  <div class="work-facts">
                    <div class="work-fact">
                      <span>Role</span>
                      <strong>{project.data.role || "个人项目"}</strong>
                    </div>
                    <div class="work-fact">
                      <span>Status</span>
                      <strong>{project.data.status}</strong>
                    </div>
                  </div>
                  <div class="tags">
                    {(project.data.stack.length ? project.data.stack : project.data.tags).map((tag) => (
                      <span class="tag">{tag}</span>
                    ))}
                  </div>
                  <a class="text-link" href={`/works/${project.id}/`}>
                    查看项目
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M14 7l5 5-5 5"></path>
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
        ) : (
          <div class="empty-panel empty-panel-large">
            <span class="empty-index">02</span>
            <div>
              <span class="mono-label">First project pending</span>
              <h2>第一件作品正在整理。</h2>
              <p>
                一个脚本、一份方案或一次完整的系统实践，都可以成为这里的第一件作品。
                等它真正完成后，再让它出现在这里。
              </p>
            </div>
            <span class="status-pill">Soon</span>
          </div>
        )
      }
    </div>
  </section>

  <section class="section section-line reveal">
    <div class="container">
      <div class="section-heading">
        <div>
          <span class="mono-label">How I work</span>
          <h2>作品不需要很多，<br>但需要值得被记住。</h2>
        </div>
        <p>技术选择不是目的。能被理解、能被维护、能解决真实问题，才构成作品。</p>
      </div>
      <div class="principles-grid">
        <article class="principle">
          <span class="principle-index">01 / CLARITY</span>
          <h3>先定义问题</h3>
          <p>不从工具出发，先确认问题是什么，以及成功应该被怎样衡量。</p>
        </article>
        <article class="principle">
          <span class="principle-index">02 / CONSTRAINT</span>
          <h3>尊重约束</h3>
          <p>时间、成本和运行环境，往往比“技术上最先进”更重要。</p>
        </article>
        <article class="principle">
          <span class="principle-index">03 / LONGEVITY</span>
          <h3>为以后设计</h3>
          <p>留下文档、稳定接口和观察能力，让下一次维护更容易。</p>
        </article>
      </div>
    </div>
  </section>
</BaseLayout>
