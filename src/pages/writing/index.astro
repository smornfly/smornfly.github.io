---
import { getCollection } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

const posts = (await getCollection("posts", ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const tags = [...new Set(posts.flatMap(({ data }) => data.tags))].sort();
---

<BaseLayout
  title="文章"
  description="Smornfly 的技术笔记、项目复盘与持续思考。"
  page="writing"
>
  <section class="container page-hero">
    <div>
      <span class="mono-label">Field notes</span>
      <h1>把经历留下，<br>让思考有迹可循。</h1>
    </div>
    <p>
      技术笔记、项目复盘和阶段思考。这里不追求更新频率，
      只在有真实内容值得记录时发布。
    </p>
  </section>

  <section class="container">
    {
      posts.length > 0 ? (
        <>
          <div class="writing-tools">
            <div class="filter-list" aria-label="按标签筛选">
              <button
                class="filter-button is-active"
                data-filter="all"
                type="button"
                aria-pressed="true"
              >
                全部
              </button>
              {tags.map((tag) => (
                <button
                  class="filter-button"
                  data-filter={tag}
                  type="button"
                  aria-pressed="false"
                >
                  {tag}
                </button>
              ))}
            </div>
            <label class="search-box">
              <span class="skip-link">搜索文章</span>
              <svg viewBox="0 0 24 24" aria-hidden="true">
                <circle cx="11" cy="11" r="7"></circle>
                <path d="m16 16 4 4"></path>
              </svg>
              <input type="search" placeholder="搜索文章…" data-post-search autocomplete="off">
            </label>
          </div>

          <div class="posts-grid">
            {posts.map((post) => (
              <article
                class="post-card"
                data-post-card
                data-categories={post.data.tags.join(" ")}
                data-search={`${post.data.title} ${post.data.description} ${post.data.tags.join(" ")}`}
              >
                <div class="post-card-meta">
                  <time datetime={post.data.date.toISOString()}>
                    {post.data.date.toISOString().slice(0, 10).replaceAll("-", " / ")}
                  </time>
                  <span>{post.data.tags[0] || "Notes"}</span>
                </div>
                <h2><a href={`/writing/${post.id}/`}>{post.data.title}</a></h2>
                <p>{post.data.description}</p>
                <div class="post-card-foot">
                  <div class="tags">
                    {post.data.tags.slice(0, 3).map((tag) => <span class="tag">{tag}</span>)}
                  </div>
                  <a class="text-link" href={`/writing/${post.id}/`}>
                    阅读
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                      <path d="M5 12h14M14 7l5 5-5 5"></path>
                    </svg>
                  </a>
                </div>
              </article>
            ))}
          </div>
          <div class="empty-state" data-empty-state>
            没有找到匹配的文章。换一个关键词试试。
          </div>
        </>
      ) : (
        <div class="empty-panel">
          <span class="empty-index">01</span>
          <div>
            <span class="mono-label">First entry pending</span>
            <h2>第一篇文章正在准备中。</h2>
            <p>
              第一篇内容发布后，这里会自动出现文章卡片、标签和搜索。
              现在先给真实经历留一点空间。
            </p>
          </div>
          <span class="status-pill">Soon</span>
        </div>
      )
    }
  </section>
</BaseLayout>
