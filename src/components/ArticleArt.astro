    <g fill="#f4f0e8">
      <circle cx="65" cy="370" r="7"></circle>
      <circle cx="320" cy="190" r="7"></circle>
      <circle cx="548" cy="301" r="7"></circle>
      <circle cx="778" cy="181" r="7"></circle>
