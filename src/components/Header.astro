---
import { site } from "../data/site";

interface Props {
  page: "home" | "writing" | "works" | "about";
}

const { page } = Astro.props;
const links = [
  { id: "home", href: "/", label: "首页" },
  { id: "writing", href: "/writing/", label: "文章" },
  { id: "works", href: "/works/", label: "作品" },
  { id: "about", href: "/about/", label: "关于" }
] as const;
---

<header class="site-header" data-header>
  <div class="nav-shell">
    <a class="brand" href="/" aria-label={`${site.title} 首页`}>
      <span class="brand-mark" aria-hidden="true"></span>
      <span class="brand-word">{site.name} / {site.subtitle}</span>
    </a>

    <nav class="nav-links" data-nav-links aria-label="主导航">
      {
        links.map((link) => (
          <a
            class="nav-link"
            href={link.href}
            aria-current={page === link.id ? "page" : undefined}
          >
            {link.label}
          </a>
        ))
      }
    </nav>

    <div class="nav-tools">
      <button class="icon-button theme-button" data-theme-toggle type="button" aria-label="切换主题">
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4"></circle>
          <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"></path>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"></path>
        </svg>
      </button>
      <button
        class="icon-button menu-button"
        data-menu-toggle
        type="button"
        aria-label="打开导航"
        aria-expanded="false"
      >
        <svg viewBox="0 0 24 24" aria-hidden="true">
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
      </button>
    </div>
  </div>
</header>
